page = PAGE

# Render the plugin records directly instead of going through
# styles.content.get, which keeps the output lean and the assertions robust.
page.10 = CONTENT
page.10 {
  table = tt_content
  select {
    orderBy = sorting
    where = {#colPos}=0
  }
}

# Without this TYPO3 swallows errors per content element, returns
# "Oops, an error occurred" and status 200 - tests would be green by mistake.
config.contentObjectExceptionHandler = 0
config.no_cache = 1
config.disableAllHeaderCode = 1

plugin.tx_news.settings {
  listPid = 2
  defaultDetailPid = 3
  detailPid = 3
  backPid = 2

  # Without tx_news_pi1[news] the detail action gets no news argument and falls
  # back to singleNews, which saves calculating a cHash in the test.
  singleNews = 1

  selectedList = 1,2
}
